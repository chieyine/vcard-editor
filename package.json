{
  "name": "vcard-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib proxy.ts next.config.ts playwright.config.ts vitest.config.ts --max-warnings=0",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "compatibility": "vitest run tests/compatibility.test.ts",
    "benchmark": "vitest run tests/performance/benchmark.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:built": "playwright test",
    "test:a11y": "npm run build && playwright test --grep @a11y",
    "format": "prettier --write app components lib proxy.ts next.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/analytics": "^2.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "fflate": "^0.8.3",
    "hucre": "^1.0.0",
    "next": "^16.3.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "regenerator-runtime": "^0.14.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
