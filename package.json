{
  "name": "vcard-editor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp-hashes.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && npm run compatibility && npm run benchmark && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "compatibility": "vitest run tests/compatibility.test.ts",
    "benchmark": "vitest run tests/performance/benchmark.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:built": "playwright test",
    "test:a11y": "npm run build && playwright test --grep @a11y"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "fflate": "0.8.2",
    "hucre": "^1.0.0",
    "next": "^16.3.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.8",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
